    as (

with raw_loan as (
    select
        loan_id,
        customer_id,
        account_id,
        principal,
        loan_type,
        status,
        interest_rate,
        origination_date,
        collateral_value,
        credit_grade,
        loan_memo
    from CI.RAW_PUBLIC_CI.loan
    where
        principal > 0
        and credit_grade in ('A', 'B', 'C', 'D')
        and status in ('ACTIVE', 'DEFAULTED', 'PAID_OFF')
)

select
    loan_id,
    customer_id,
