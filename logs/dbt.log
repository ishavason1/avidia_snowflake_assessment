  loan_type,
  status,
  interest_rate,
  origination_date,
  collateral_value,
  credit_grade,
  loan_memo
  -- Audit columns
  current_timestamp() as dbt_loaded_at,
  'RAW.PUBLIC.LOAN' as source_table,
  'RAW' as source_system
from raw_loan
    )

