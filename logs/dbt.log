-- stg_loan: Clean, standardized loans

with raw_loan as (
  select
    loan_id,
    customer_id,
    account_id,
    principal,
    loan_type,
    status,
    interest_rate,
    origination_date,
    collateral_value,
    credit_grade,
    loan_memo,
    created_at as source_created_at
  from RAW.PUBLIC.loan
  where principal > 0  -- Validity: loan must have positive principal
    and credit_grade in ('A', 'B', 'C', 'D')  -- Validity: must be valid grade
    and status in ('ACTIVE', 'DEFAULTED', 'PAID_OFF')  -- Validity: must be valid status
)

select
  loan_id,
  customer_id,
  account_id,
  principal,
  loan_type,
  status,
  interest_rate,
  origination_date,
  collateral_value,
  credit_grade,
  loan_memo,
  source_created_at,
  -- Audit columns
  current_timestamp() as dbt_loaded_at,
  'RAW.PUBLIC.LOAN' as source_table,
  'RAW' as source_system
from raw_loan
    )

