  -- tests/test_mart_deposits_accuracy.sql
-- ACCURACY: Mart total deposit balances must reconcile to GL within $1
-- This is the "trusted and reconciled" test - ensures data integrity

with mart_totals as (
  select
    sum(current_balance) as mart_total_balance
  from analytics.PUBLIC_marts.mart_deposits
),

gl_totals as (
  select
    balance_total as gl_total_deposits
  from RAW.PUBLIC.gl_control
  where gl_account = '1010'
    and business_date = current_date()
)

select
  abs(mt.mart_total_balance - gt.gl_total_deposits) as reconciliation_difference
from mart_totals mt
cross join gl_totals gt
where abs(mt.mart_total_balance - gt.gl_total_deposits) > 1.00
  
  
      
    ) dbt_internal_test
