[0m09:39:06.373524 [debug] [MainThread]: On master: INSERT INTO GOVERNANCE.CATALOG.DQ_RESULT (
        DQ_RESULT_ID,
        MART_NAME,
        CHECK_DIMENSION,
        CHECK_TYPE,
        TARGET_TABLE,
        TARGET_COLUMN,
        CHECK_RESULT,
        FAILED_ROWS,
        TOTAL_ROWS,
        DETAILS,
        EXECUTED_AT,
        EXECUTED_BY
      )
      SELECT
        'DQ_' || MD5(CONCAT(tm.TEST_NAME, '_', CURRENT_TIMESTAMP()::VARCHAR)) as DQ_RESULT_ID,
        CASE 
          WHEN TARGET_TABLE LIKE '%MART_%' THEN SUBSTR(TARGET_TABLE, POSITION('MART_' IN TARGET_TABLE))
          ELSE 'UNKNOWN' 
        END as MART_NAME,
        tm.DIMENSION as CHECK_DIMENSION,
        tm.TEST_NAME as CHECK_TYPE,
        tm.TARGET_TABLE,
        tm.TARGET_COLUMN,
        CASE 
          WHEN COALESCE(dbt_failures.ROWCOUNT, 0) = 0 THEN 'PASS'
          ELSE 'FAIL'
        END as CHECK_RESULT,
        COALESCE(dbt_failures.ROWCOUNT, 0) as FAILED_ROWS,
        (SELECT COUNT(*) FROM ANALYTICS.MARTS.MART_DEPOSITS) as TOTAL_ROWS,
        CONCAT(
          'Test: ', tm.TEST_NAME, 
          '. Dimension: ', tm.DIMENSION,
          '. Target: ', tm.TARGET_TABLE,
          '. Result: ', CASE WHEN COALESCE(dbt_failures.ROWCOUNT, 0) = 0 THEN 'PASS' ELSE 'FAIL' END
        ) as DETAILS,
        CURRENT_TIMESTAMP() as EXECUTED_AT,
        CURRENT_USER() as EXECUTED_BY
      FROM GOVERNANCE.CATALOG.TEST_METADATA tm
      LEFT JOIN (
        -- Get actual test failure counts from dbt_test_failures tables
        SELECT 'test_mart_deposits_completeness' as TEST_NAME, COUNT(*) as ROWCOUNT 
        FROM GOVERNANCE.CATALOG.dbt_test_failures_test_mart_deposits_completeness_
        UNION ALL
        SELECT 'test_mart_deposits_uniqueness', COUNT(*) 
        FROM GOVERNANCE.CATALOG.dbt_test_failures_test_mart_deposits_uniqueness_
        UNION ALL
        SELECT 'test_mart_deposits_validity', COUNT(*) 
        FROM GOVERNANCE.CATALOG.dbt_test_failures_test_mart_deposits_validity_
        UNION ALL
        SELECT 'test_mart_deposits_consistency', COUNT(*) 
        FROM GOVERNANCE.CATALOG.dbt_test_failures_test_mart_deposits_consistency_
        UNION ALL
        SELECT 'test_mart_deposits_timeliness', COUNT(*) 
        FROM GOVERNANCE.CATALOG.dbt_test_failures_test_mart_deposits_timeliness_
        UNION ALL
        SELECT 'test_mart_deposits_accuracy', COUNT(*) 
        FROM GOVERNANCE.CATALOG.dbt_test_failures_test_mart_deposits_accuracy_
      ) dbt_failures ON tm.TEST_NAME = dbt_failures.TEST_NAME
