  -- tests/test_mart_deposits_timeliness.sql
-- TIMELINESS: Data must be fresh - at least one account with transaction in last 7 days
-- This ensures the mart is refreshed regularly with current data

with latest_activity as (
  select
    max(latest_business_date) as most_recent_transaction
  from analytics.PUBLIC_marts.mart_deposits
)

select
  case
    when most_recent_transaction < current_date() - 7 then 1
    when most_recent_transaction is null then 1
    else 0
  end as timeliness_violation
from latest_activity
having sum(timeliness_violation) > 0
  
  
      
    ) dbt_internal_test
