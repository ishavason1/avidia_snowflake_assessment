-- stg_account: Clean, standardized accounts

with raw_account as (
  select
    account_id,
    customer_id,
    account_number,
    account_type,
    status,
    balance,
    branch_code,
    opened_date,
    created_at as source_created_at
  from RAW.PUBLIC.account
  where status in ('ACTIVE', 'CLOSED')  -- Validity: must be valid status
)

select
  account_id,
  customer_id,
  account_number,
  account_type,
  status,
  balance,
  branch_code,
