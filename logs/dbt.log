  transaction_id,
  account_id,
  business_date,
  transaction_type,
  amount,
  memo,
  source_created_at,
  -- Audit columns
  current_timestamp() as dbt_loaded_at,
  'RAW.PUBLIC.TRANSACTION' as source_table,
  'RAW' as source_system
from raw_transaction
    )

