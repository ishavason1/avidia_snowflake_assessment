with raw_loan as (
  select
    loan_id,
    customer_id,
    account_id,
    principal,
    loan_type,
    status,
    interest_rate,
    origination_date,
    collateral_value,
    credit_grade,
    loan_memo
  from RAW.PUBLIC.loan
  where principal > 0
    and credit_grade in ('A', 'B', 'C', 'D')
    and status in ('ACTIVE', 'DEFAULTED', 'PAID_OFF')
)

select
  loan_id,
  customer_id,
  account_id,
  principal,
  loan_type,
  status,
  interest_rate,
  origination_date,
  collateral_value,
  credit_grade,
  loan_memo,
  current_timestamp() as dbt_loaded_at,
  'RAW.PUBLIC.LOAN' as source_table,
  'RAW' as source_system
from raw_loan
    )

