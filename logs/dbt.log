-- stg_loan: Clean, standardized loans

with raw_loan as (
  select
    loan_id,
    customer_id,
    account_id,
    principal,
    loan_type,
    status,
    interest_rate,
    origination_date,
    collateral_value,
    credit_grade,
    loan_memo,
    created_at as source_created_at
  from RAW.PUBLIC.loan
  where principal > 0  -- Validity: loan must have positive principal
    and credit_grade in ('A', 'B', 'C', 'D')  -- Validity: must be valid grade
